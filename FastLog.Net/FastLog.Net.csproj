<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <Configurations>Debug;Release</Configurations>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <OutputPath>bin\$(Platform)\$(Configuration)</OutputPath>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <Import Project="..\..\..\IRLPR\Build\Configurations\Release.AnyCPU.props" />
  <Import Project="..\..\..\IRLPR\Build\Configurations\Debug.AnyCPU.props" />
  <ItemGroup>
    <Compile Include="..\..\..\IRLPR\GlobalAssemblyInfo.cs" Link="GlobalAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.3" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FastConsoleNet\FastConsole\FastConsoleNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Factories\FileAndConsoleLoggerFactory.cs" />
  </ItemGroup>
</Project>
